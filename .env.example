RESUME_PARSER_PROVIDER=affinda
AFFINDA_API_KEY=your_affinda_api_key_here
# Optional, if your Affinda account uses specific routing:
# AFFINDA_WORKSPACE=your_workspace_identifier
# AFFINDA_COLLECTION=your_collection_identifier

# Resend email sending. Keep this server-side only in Vercel env vars.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=assistant@welcomeflowhq.com
RESEND_FROM_NAME=WelcomeFlow Assistant

# Emergency maintenance controls. Set both to true in Vercel Production only.
REACT_APP_MAINTENANCE_MODE=false
WELCOMEFLOW_MAINTENANCE_MODE=false
