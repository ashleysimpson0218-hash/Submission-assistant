RESUME_PARSER_PROVIDER=affinda
AFFINDA_API_KEY=your_affinda_api_key_here
# Optional, if your Affinda account uses specific routing:
# AFFINDA_WORKSPACE=your_workspace_identifier
# AFFINDA_COLLECTION=your_collection_identifier

# Resend email sending. Keep this server-side only in Vercel env vars.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=assistant@welcomeflowhq.com
RESEND_FROM_NAME=WelcomeFlow Assistant
# Server-side authorization and recipient policy for /api/send-email.
# Never expose these values through REACT_APP_* variables.
SUPABASE_URL=https://your-authorized-project-ref.supabase.co
SUPABASE_ANON_KEY=your_server_publishable_or_anon_key_here
WELCOMEFLOW_EMAIL_ALLOWED_RECIPIENTS=recruiter@example.test
WELCOMEFLOW_EMAIL_ALLOWED_DOMAINS=example.test
WELCOMEFLOW_EMAIL_RATE_LIMIT_PER_MINUTE=10

# Emergency maintenance controls. Set both to true in Vercel Production only.
REACT_APP_MAINTENANCE_MODE=false
WELCOMEFLOW_MAINTENANCE_MODE=false

# Required whenever the full application is enabled.
REACT_APP_ENVIRONMENT=test
REACT_APP_SUPABASE_URL=https://your-test-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_test_publishable_or_anon_key_here
REACT_APP_ALLOWED_SUPABASE_PROJECT_REF=your-test-project-ref

# Optional test workspace selection. Create React App requires the REACT_APP_ prefix.
# Acceptance mode requires an explicit non-default workspace, exact expected counts,
# and the SHA-256 fingerprint produced by the acceptance fixture generator.
# REACT_APP_WELCOMEFLOW_WORKSPACE_ID=phase1-acceptance-synthetic
# REACT_APP_WELCOMEFLOW_ACCEPTANCE_MODE=true
# REACT_APP_WELCOMEFLOW_AUTOSAVE=false
# REACT_APP_WELCOMEFLOW_EXPECTED_CANDIDATES=100
# REACT_APP_WELCOMEFLOW_EXPECTED_FACILITIES=32
# REACT_APP_WELCOMEFLOW_EXPECTED_REQUISITIONS=114
# REACT_APP_WELCOMEFLOW_EXPECTED_HISTORY=200
# REACT_APP_WELCOMEFLOW_EXPECTED_REPORT_HISTORY=53
# REACT_APP_WELCOMEFLOW_EXPECTED_WORKSPACE_FINGERPRINT=approved_fixture_sha256

# Owner UAT Preview. The publishable key is safe in the client; RLS and owner authentication protect data.
# Client build variables:
# REACT_APP_ENVIRONMENT=uat
# REACT_APP_MAINTENANCE_MODE=false
# REACT_APP_SUPABASE_URL=https://zleslkwnbjxknmkqywyv.supabase.co
# REACT_APP_SUPABASE_ANON_KEY=your_owner_uat_publishable_key_here
# REACT_APP_ALLOWED_SUPABASE_PROJECT_REF=zleslkwnbjxknmkqywyv
# Server-only Preview variable; keeps recruiting communications and external APIs disabled:
# WELCOMEFLOW_UAT_EXTERNAL_ACTIONS_DISABLED=true
